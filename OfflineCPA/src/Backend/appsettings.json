{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Uploads": {
    "Directory": "data/user-assets",
    "MaxBytes": 20971520,
    "AllowedExtensions": [ ".csv", ".ofx", ".qfx", ".pdf", ".png", ".jpg", ".jpeg" ],
    "AllowedContentTypes": [ "text/csv", "application/ofx", "application/x-ofx", "application/qfx", "application/pdf", "image/png", "image/jpeg" ]
  }
}

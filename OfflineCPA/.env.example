# Copy this file to .env and fill in real values, or run scripts/init-env.sh to
# generate a random password automatically. Never commit .env.
# CONNECTION_STRING is for dotnet run on the host with the dev override. Compose builds its own string.
POSTGRES_PASSWORD=replace-with-generated-password
CONNECTION_STRING=Host=localhost;Port=5432;Database=OfflineCPADb;Username=bookkeeping;Password=replace-with-generated-password
# Pii__FingerprintKey keeps masking fingerprints stable across machines. Unset
# (default): a key is generated once and stored in data/pii-fingerprint.key.
# Generate a value with: openssl rand -base64 32
Pii__FingerprintKey=
